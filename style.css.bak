/* ============================================================================
   SOUTENANCE PFE — YOLO Benchmark Platform
   Feuille de style académique — Université Mohammed Premier / FPN
   Palette : blanc · bleu marine · bleu clair · cyan · gris très clair
   Typo    : Poppins (titres) · Inter (texte)
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. DESIGN TOKENS
   -------------------------------------------------------------------------- */
:root{
  /* Couleurs de marque */
  --navy-900:#08192E;
  --navy-800:#0B2A4A;
  --navy-700:#12395F;
  --navy-600:#1B4C79;
  --navy-500:#2A6291;

  --blue-500:#2E7FB8;
  --blue-400:#4A9BD1;

  --cyan-600:#0B93AC;
  --cyan-500:#0EA5C4;
  --cyan-400:#2FC1DE;
  --cyan-100:#E3F7FA;

  --white:#FFFFFF;
  --gray-50:#F7F9FC;
  --gray-100:#EEF2F7;
  --gray-200:#E3E9F1;
  --gray-300:#D3DCE6;
  --gray-400:#AEBBCB;
  --gray-500:#8496AC;
  --gray-600:#5F7188;
  --gray-700:#445369;

  --ink:#132338;          /* texte principal */
  --ink-soft:#4F6178;     /* texte secondaire */
  --ink-mute:#8496AC;     /* texte tertiaire / légendes */

  --line:#DFE6EF;
  --line-soft:#EAEFF5;
  --bg-app:#F5F8FB;
  --bg-soft:#F7FAFC;
  --bg-card:#FFFFFF;

  --success:#2FA84F;
  --warning:#D97706;
  --danger:#C0392B;
  --violet:#6D5DD3;

  /* alias historiques référencés en inline dans le HTML */
  --abd-blue:#1D4ED8;
  --abd-green:#16A34A;
  --card-color:var(--cyan-500);

  /* Typographie */
  --f-display:'Poppins', 'Segoe UI', sans-serif;
  --f-text:'Inter', 'Segoe UI', sans-serif;
  --f-mono:'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;

  --fs-h1: clamp(2rem, 1.35rem + 2.1vw, 2.75rem);      /* ~38-44px titre couverture */
  --fs-h2: clamp(1.5rem, 1.15rem + 1.1vw, 1.9rem);      /* ~28-30px titre slide */
  --fs-h3: clamp(1.05rem, 0.9rem + 0.5vw, 1.25rem);     /* ~19-20px sous-titre */
  --fs-body: clamp(0.92rem, 0.84rem + 0.28vw, 1.05rem); /* ~18-20px texte */
  --fs-small: clamp(0.78rem, 0.73rem + 0.16vw, 0.86rem);/* ~14-15px légendes */
  --fs-micro: clamp(0.68rem, 0.65rem + 0.1vw, 0.74rem);

  /* Espacements / grille */
  --space-1: 6px;
  --space-2: 10px;
  --space-3: 16px;
  --space-4: 22px;
  --space-5: 30px;
  --space-6: 42px;

  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-pill: 999px;

  --shadow-xs: 0 1px 3px rgba(11,42,74,.06);
  --shadow-sm: 0 2px 10px rgba(11,42,74,.07);
  --shadow-md: 0 10px 28px rgba(11,42,74,.10);
  --shadow-lg: 0 18px 46px rgba(11,42,74,.14);

  --ease: cubic-bezier(.22,.61,.36,1);
  --dur-fast: .22s;
  --dur-med: .45s;
  --dur-slow: .7s;

  --topbar-h: 52px;
  --footer-h: 40px;
  --slide-pad-x: clamp(28px, 5vw, 96px);
  --slide-pad-y: clamp(18px, 3.6vh, 52px);
}

/* --------------------------------------------------------------------------
   2. RESET & BASE
   -------------------------------------------------------------------------- */
*, *::before, *::after{ box-sizing:border-box; }
html, body{
  margin:0; padding:0;
  width:100%; height:100%;
  overflow:hidden;
  background:var(--bg-app);
  color:var(--ink);
  font-family:var(--f-text);
  font-size:16px;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
  text-rendering:optimizeLegibility;
}
h1,h2,h3,h4,h5{
  font-family:var(--f-display);
  color:var(--navy-800);
  margin:0;
  line-height:1.22;
  letter-spacing:-.01em;
}
h3{ font-size:var(--fs-h3); font-weight:600; }
h4{ font-size:calc(var(--fs-body) + 1px); font-weight:600; }
p{ margin:0; }
ul, ol{ margin:0; padding:0; list-style:none; }
button{ font-family:inherit; }
img{ max-width:100%; display:block; }
strong{ color:var(--navy-800); font-weight:600; }
em{ color:var(--cyan-600); font-style:italic; }
svg{ display:block; }
::selection{ background:var(--cyan-100); color:var(--navy-800); }

/* Scrollbar (au cas où) — fine et discrète, jamais visible en usage normal */
*::-webkit-scrollbar{ width:6px; height:6px; }
*::-webkit-scrollbar-thumb{ background:var(--gray-300); border-radius:99px; }
*::-webkit-scrollbar-track{ background:transparent; }

/* --------------------------------------------------------------------------
   3. FOND ANIMÉ (canvas réseau de neurones, discret)
   -------------------------------------------------------------------------- */
#bg-canvas{
  position:fixed; inset:0;
  width:100%; height:100%;
  z-index:0;
  pointer-events:none;
  opacity:.55;
}

/* --------------------------------------------------------------------------
   4. BARRE DE PROGRESSION
   -------------------------------------------------------------------------- */
.progress-track{
  position:fixed; top:0; left:0; right:0;
  height:3px;
  background:var(--gray-100);
  z-index:60;
}
.progress-fill{
  height:100%;
  width:0%;
  background:linear-gradient(90deg, var(--cyan-500), var(--navy-700));
  transition:width var(--dur-med) var(--ease);
}

/* --------------------------------------------------------------------------
   5. TOPBAR
   -------------------------------------------------------------------------- */
.topbar{
  position:fixed; bottom:3px; left:0; right:0; height:var(--topbar-h);
  display:flex; align-items:center; justify-content:space-between;
  padding:0 clamp(16px, 3vw, 40px);
  z-index:55;
  background:rgba(31, 64, 110, 0.72);
  backdrop-filter:blur(10px);
  -webkit-backdrop-filter:blur(10px);
  border-top:1px solid var(--line-soft);
  border-bottom:none;
  width: 1%;
}
.topbar-brand{ display:flex; align-items:center; gap:10px; font-family:var(--f-display); font-weight:600; color:var(--navy-800); font-size:.75rem; }
.topbar-actions{ display:flex; align-items:center; gap:10px; }

.icon-btn{
  appearance:none; border:1px solid var(--line);
  background:var(--white);
  color:var(--navy-700);
  font-family:var(--f-text);
  font-weight:500;
  font-size:.76rem;
  letter-spacing:.01em;
  padding:8px 16px;
  border-radius:var(--radius-pill);
  cursor:pointer;
  display:inline-flex; align-items:center; gap:6px;
  transition:all var(--dur-fast) var(--ease);
  box-shadow:var(--shadow-xs);
}
.icon-btn:hover{ background:var(--navy-800); color:var(--white); border-color:var(--navy-800); box-shadow:var(--shadow-sm); transform:translateY(-1px); }
.text-btn{ font-size:.72rem; }

/* --------------------------------------------------------------------------
   6. MENU DE NAVIGATION (SOMMAIRE)
   -------------------------------------------------------------------------- */
.menu-scrim{
  position:fixed; inset:0; z-index:70;
  background:rgba(8,25,46,.42);
  backdrop-filter:blur(2px);
  opacity:0; visibility:hidden;
  transition:opacity var(--dur-med) var(--ease);
}
.menu-scrim.active{ opacity:1; visibility:visible; }

.slide-menu{
  position:fixed; top:0; right:0; bottom:0;
  width:min(380px, 88vw);
  background:var(--white);
  z-index:80;
  box-shadow:-24px 0 60px rgba(11,42,74,.18);
  transform:translateX(100%);
  transition:transform var(--dur-slow) var(--ease);
  border-left:1px solid var(--line);
}
.slide-menu.active{ transform:translateX(0); }
.slide-menu-inner{ height:100%; overflow-y:auto; padding:36px 28px; }
.slide-menu-title{
  font-family:var(--f-display); font-weight:700; font-size:.72rem;
  letter-spacing:.14em; text-transform:uppercase;
  color:var(--cyan-600); margin:0 0 22px;
}
.slide-menu-list{ display:flex; flex-direction:column; gap:2px; }
.slide-menu-list li{
  display:flex; align-items:baseline; gap:14px;
  padding:11px 10px;
  border-radius:var(--radius-sm);
  cursor:pointer;
  color:var(--ink-soft);
  font-size:.88rem;
  transition:background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.slide-menu-list li:hover{ background:var(--gray-50); color:var(--navy-800); }
.slide-menu-list li.active{ background:var(--cyan-100); color:var(--navy-800); font-weight:600; }
.slide-menu-list .mnum{
  font-family:var(--f-mono); font-size:.7rem; color:var(--cyan-600);
  min-width:22px;
}

/* --------------------------------------------------------------------------
   7. DECK & SLIDES
   -------------------------------------------------------------------------- */
.deck{
  position:fixed;
  top:0; left:0; right:0; bottom:0;
  z-index:1;
}
.slide{
  position:absolute; inset:0;
  display:flex;
  align-items:center; justify-content:center;
  padding-bottom:var(--footer-h);
  opacity:0;
  visibility:hidden;
  pointer-events:none;
  transform:translateY(14px) scale(.99);
  transition:opacity var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease), visibility 0s linear var(--dur-slow);
}
.slide.active{
  opacity:1;
  visibility:visible;
  pointer-events:auto;
  transform:translateY(0) scale(1);
  transition:opacity var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease), visibility 0s linear 0s;
  z-index:3;
}
.slide.prev{
  opacity:0;
  transform:translateY(-14px) scale(.99);
  z-index:2;
}

.slide-inner{
  position:relative;
  width:100%;
  height:100%;
  max-width:1280px;
  margin:0 auto;
  padding:var(--slide-pad-y) var(--slide-pad-x);
  display:flex;
  flex-direction:column;
  overflow:hidden; /* le JS gère la mise à l'échelle du fit-wrap : jamais de scroll */
}
.slide-inner.wide{ max-width:1360px; }

/* .fit-wrap : injecté par script.js, contient tout le contenu réel de la slide
   et reçoit un transform:scale() calculé en JS pour ne jamais déborder */
.fit-wrap{
  transform-origin:top center;
  display:flex;
  flex-direction:column;
  width:100%;
  margin:auto 0;
  gap:0;
}

/* --------------------------------------------------------------------------
   8. TYPOGRAPHIE COMMUNE DE SLIDE (eyebrow, titres)
   -------------------------------------------------------------------------- */
.eyebrow{
  font-family:var(--f-display);
  font-weight:600;
  font-size:.72rem;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--cyan-600);
  margin:0 0 10px;
  display:flex; align-items:center; gap:8px;
}
.eyebrow::before{
  content:'';
  width:22px; height:2px;
  background:linear-gradient(90deg, var(--cyan-500), var(--navy-700));
  border-radius:2px;
  display:inline-block;
}
.eyebrow.center{ justify-content:center; }
.eyebrow.center::before{ display:none; }

.slide-title{
  font-family:var(--f-display);
  font-size:var(--fs-h2);
  font-weight:700;
  color:var(--navy-800);
  margin:0 0 22px;
  letter-spacing:-.015em;
  position:relative;
}

/* --------------------------------------------------------------------------
   9. ANIMATIONS D'APPARITION (discrètes — fade + slide up)
   -------------------------------------------------------------------------- */
@keyframes revealUp{
  from{ opacity:0; transform:translateY(14px); }
  to{ opacity:1; transform:translateY(0); }
}
@keyframes revealIn{
  from{ opacity:0; }
  to{ opacity:1; }
}
.reveal-item{
  animation:revealUp var(--dur-slow) var(--ease) both;
}
.reveal-stagger > *{
  animation:revealUp var(--dur-slow) var(--ease) both;
}
.reveal-stagger > *:nth-child(1){ animation-delay:.04s; }
.reveal-stagger > *:nth-child(2){ animation-delay:.11s; }
.reveal-stagger > *:nth-child(3){ animation-delay:.18s; }
.reveal-stagger > *:nth-child(4){ animation-delay:.25s; }
.reveal-stagger > *:nth-child(5){ animation-delay:.32s; }
.reveal-stagger > *:nth-child(6){ animation-delay:.39s; }
.reveal-stagger > *:nth-child(7){ animation-delay:.46s; }
.reveal-stagger > *:nth-child(8){ animation-delay:.53s; }
.reveal-stagger > *:nth-child(9){ animation-delay:.60s; }
.reveal-stagger > *:nth-child(10){ animation-delay:.67s; }
.reveal-stagger > *:nth-child(11){ animation-delay:.74s; }
.reveal-stagger > *:nth-child(12){ animation-delay:.81s; }

@media (prefers-reduced-motion: reduce){
  .reveal-item, .reveal-stagger > *{ animation:none !important; }
  .slide{ transition:opacity .2s linear !important; transform:none !important; }
}

/* ============================================================================
   10. PRIMITIVES DE MISE EN PAGE
   ========================================================================== */
.grid-2{
  display:grid;
  grid-template-columns:1.15fr .85fr;
  gap:var(--space-5);
  align-items:start;
  width:100%;
}
.gap-xl{ gap:var(--space-6); }

.stack-list{
  display:flex;
  flex-direction:column;
  gap:var(--space-3);
}

.context-row{
  padding:16px 20px;
  background:var(--bg-card);
  border:1px solid var(--line);
  border-left:3px solid var(--cyan-500);
  border-radius:var(--radius-md);
  box-shadow:var(--shadow-xs);
}
.context-row h3{
  font-size:calc(var(--fs-body) + 1px);
  color:var(--navy-800);
  margin-bottom:6px;
}
.context-row p{
  font-size:var(--fs-small);
  line-height:1.6;
  color:var(--ink-soft);
}
.cnn-onestage-row{ display:grid; grid-template-columns:1fr 1fr; gap:var(--space-4); border:none; padding:0; background:none; box-shadow:none; }
.cnn-onestage-col{
  padding:20px 22px;
  background:var(--bg-card);
  border:1px solid var(--line);
  border-radius:var(--radius-lg);
  box-shadow:var(--shadow-xs);
}
.cnn-onestage-col h3{ font-size:calc(var(--fs-body) + 1px); margin-bottom:8px; color:var(--navy-800); }
.cnn-onestage-col p{ font-size:var(--fs-small); line-height:1.65; color:var(--ink-soft); }

.app-panel{
  background:linear-gradient(165deg, var(--navy-800), var(--navy-700));
  border-radius:var(--radius-lg);
  padding:24px;
  box-shadow:var(--shadow-md);
  height:60%;
  
}
.panel-title{
  color:var(--white);
  font-size:var(--fs-small);
  font-weight:600;
  margin-bottom:16px;
  opacity:.92;
}
.app-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}
.app-chip{
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.16);
  color:var(--white);
  font-size:var(--fs-small);
  font-weight:500;
  padding:11px 12px;
  border-radius:var(--radius-sm);
  text-align:center;
  transition:background var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}
.app-chip:hover{ background:var(--cyan-500); transform:translateY(-2px); }

.soft-note{
  font-size:var(--fs-small);
  color:var(--ink-mute);
  font-style:italic;
}
.mono-tag{
  font-family:var(--f-mono);
  font-size:.85em;
  background:var(--gray-100);
  color:var(--navy-700);
  padding:1px 6px;
  border-radius:5px;
}
.center{ text-align:center; }

.card-base,
.problem-card, .research-question, .yolo-intro-card,
.ccl-card, .cnn-card, .head-card, .res-shot-card{
  background:var(--bg-card);
  border:1px solid var(--line);
  border-radius:var(--radius-lg);
  box-shadow:var(--shadow-sm);
  transition:transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
}

/* ============================================================================
   11. COUVERTURE (SLIDE 1)
   ========================================================================== */
.cover{
  position:relative;
  height:100%;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  padding:6vh 3vw;
  text-align:center;
  overflow:hidden;
}
.cover-bg{
  position:absolute; inset:0;
  z-index:0;
  opacity:.16;
  pointer-events:none;
}
.cover-network{ width:100%; height:100%; }
.cover-net-lines line{ opacity:.7; }
.cover-net-dots circle{ opacity:.55; }

.cover-top, .cover-mid, .cover-bottom{ position:relative; z-index:1;       margin-bottom: 8%; /* remonte de 30px */
}

.cover-top{ display:flex; flex-direction:column; gap:4px;}
.cover-univ{
  font-family:var(--f-display); font-weight:600; font-size:.95rem;
  color:var(--navy-800); letter-spacing:.01em;
      


}
.cover-fac{ font-size:.82rem; color:var(--ink-soft); }
.cover-dept{
  font-size:.76rem; color:var(--cyan-600); font-weight:600;
  letter-spacing:.04em; text-transform:uppercase; margin-top:6px;
}

.cover-mid{
  display:flex; flex-direction:column; align-items:center; gap:22px;
  max-width:900px; margin:0 auto;
}
.eyebrow-pill{
  display:inline-flex; align-items:center;
  padding:9px 22px;
  border-radius:var(--radius-pill);
  background:var(--cyan-100);
  color:var(--cyan-600);
  font-family:var(--f-display);
  font-weight:600;
  font-size:.72rem;
  letter-spacing:.12em;
  text-transform:uppercase;
  border:1px solid rgba(14,165,196,.25);
}
.cover-title{
  font-family:var(--f-display);
  font-weight:700;
  font-size:var(--fs-h1);
  line-height:1.2;
  color:var(--navy-800);
  letter-spacing:-.02em;
}
.grad-text{
  display:inline-block;
  margin-left:.32em;
  background:linear-gradient(100deg, var(--navy-800), var(--cyan-500) 70%);
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.cover-bottom{ display:flex; flex-direction:column; align-items:center; gap:18px;    margin-top: 80px; /* augmente la valeur selon le besoin */
 }
.cover-people{
  display:flex; align-items:center; gap:28px;
  padding:16px 34px;
  background:var(--bg-card);
  border:1px solid var(--line);
  border-radius:var(--radius-lg);
  box-shadow:var(--shadow-sm);
}
.cover-person{ display:flex; flex-direction:column; gap:3px; text-align:left; }
.cover-person-label{ font-size:.68rem; text-transform:uppercase; letter-spacing:.1em; color:var(--ink-mute); font-weight:600; }
.cover-person-name{ font-family:var(--f-display); font-weight:600; font-size:.95rem; color:var(--navy-800); }
.cover-divider{ width:1px; height:34px; background:var(--line); }
.cover-year{ font-size:.78rem; color:var(--ink-mute); letter-spacing:.02em; }

/* ============================================================================
   12. NAVIGATION FLOTTANTE (dots, flèches, compteur)
   ========================================================================== */
.dots{
  position:fixed; right:22px; top:50%; transform:translateY(-50%);
  z-index:50;
  display:flex; flex-direction:column; gap:9px;
}
.dot{
  width:7px; height:7px; border-radius:50%;
  background:var(--gray-300);
  cursor:pointer;
  transition:all var(--dur-fast) var(--ease);
}
.dot:hover{ background:var(--cyan-400); }
.dot.active{ background:var(--navy-800); width:8px; height:22px; border-radius:5px; }

.arrow-nav{
  position:fixed; top:50%; transform:translateY(-50%);
  z-index:50;
  width:42px; height:42px;
  border-radius:50%;
  border:1px solid var(--line);
  background:rgba(255,255,255,.85);
  backdrop-filter:blur(8px);
  color:var(--navy-700);
  display:flex; align-items:center; justify-content:center;
  cursor:pointer;
  box-shadow:var(--shadow-sm);
  transition:all var(--dur-fast) var(--ease);
}
.arrow-nav svg{ width:18px; height:18px; }
.arrow-nav:hover{ background:var(--navy-800); color:var(--white); border-color:var(--navy-800); }
.arrow-nav-left{ left:22px; }
.arrow-nav-right{ right:22px; }

.controls{
  position:fixed; bottom:14px; left:0; right:0;
  display:flex; justify-content:center;
  z-index:50;
  pointer-events:none;
}
.slide-counter{
  font-family:var(--f-mono);
  font-size:.76rem;
  color:var(--ink-mute);
  background:rgba(255,255,255,.85);
  backdrop-filter:blur(8px);
  border:1px solid var(--line);
  padding:5px 14px;
  border-radius:var(--radius-pill);
  letter-spacing:.03em;
}
.slide-counter #counter-current{ color:var(--navy-800); font-weight:700; }
.counter-sep{ margin:0 3px; color:var(--gray-400); }

.icon-sprite{ position:absolute; width:0; height:0; overflow:hidden; }

/* ============================================================================
   13. PLAN DE LA PRÉSENTATION (frise verticale)
   ========================================================================== */
.plan-wrap{ display:flex; justify-content:center; width:100%; }
.plan-timeline{
  position:relative;
  display:flex; flex-direction:column;
  gap:2px;
  width:100%; max-width:620px;
  counter-reset:plan;
}
.plan-timeline::before{
  content:'';
  position:absolute; left:19px; top:10px; bottom:10px;
  width:1px;
  background:var(--line);
}
.plan-item{
  position:relative;
  display:flex; align-items:center; gap:18px;
  padding:13px 16px 13px 0;
}
.plan-marker{
  position:relative; z-index:1;
  width:11px; height:11px; border-radius:50%;
  background:var(--white);
  border:2px solid var(--gray-300);
  margin-left:14px;
  flex:0 0 auto;
  transition:all var(--dur-fast) var(--ease);
}
.plan-item.active .plan-marker{ border-color:var(--cyan-500); background:var(--cyan-500); box-shadow:0 0 0 4px var(--cyan-100); }
.plan-num{
  font-family:var(--f-mono);
  font-size:.78rem; color:var(--ink-mute);
  min-width:26px;
}
.plan-label{
  font-size:var(--fs-body);
  color:var(--ink-soft);
  font-weight:500;
}
.plan-item.active .plan-label{ color:var(--navy-800); font-weight:600; }
.plan-item.active .plan-num{ color:var(--cyan-600); }
.plan-item:hover{ background:var(--gray-50); border-radius:var(--radius-sm); }

/* ============================================================================
   14. DÉFIS DE LA COMPUTER VISION — roue radiale
   ========================================================================== */
.challenge-wheel{
  position:relative;
  width:min(74vw, 860px);
  aspect-ratio: 720 / 562;
  margin:0 auto;
}
.challenge-links{ position:absolute; inset:0; width:100%; height:100%; }
.challenge-link{ stroke:url(#linkGrad); stroke-width:2; }

.challenge-hub{
  position:absolute; top:48.2%; left:50%; transform:translate(-50%,-50%);
  width:23%; aspect-ratio:1;
  border-radius:50%;
  background:radial-gradient(120% 120% at 24% 20%, var(--cyan-600) 0%, var(--navy-800) 78%);
  box-shadow:0 16px 34px rgba(11,42,74,.28), inset 0 1px 0 rgba(255,255,255,.12);
  display:flex; align-items:center; justify-content:center;
  text-align:center;
  z-index:2;
}
.challenge-hub-title{
  color:var(--white);
  font-family:var(--f-display);
  font-weight:700;
  font-size:clamp(.82rem, 1.5vw, 1.05rem);
  line-height:1.32;
  padding:0 10%;
}
.challenge-node{
  /* réinitialisation des styles natifs de <button> */
  appearance:none;
  font-family:inherit;
  margin:0;

  position:absolute;
  top:var(--y); left:var(--x);
  width:25%;
  transform:translate(-50%,-50%);
  background:var(--white);
  border:1px solid var(--line-soft);
  border-radius:16px;
  padding:14px 16px;
  text-align:center;
  box-shadow:0 10px 26px rgba(11,42,74,.09);
  cursor:pointer;
  transition:transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  z-index:1;
}
.challenge-node:hover, .challenge-node:focus-visible{
  border-color:var(--cyan-400);
  box-shadow:0 16px 34px rgba(11,42,74,.16);
  transform:translate(-50%,-50%) translateY(-5px);
}
.challenge-node:focus-visible{ outline:2px solid var(--cyan-500); outline-offset:2px; }
.challenge-node:active{ transform:translate(-50%,-50%) translateY(-2px); }
.challenge-node h4{
  font-size:clamp(.74rem, 1.15vw, .88rem);
  font-weight:700;
  color:#1B2430;
  margin-bottom:4px;
  line-height:1.3;
}
.challenge-node p{ font-size:clamp(.64rem, .95vw, .75rem); color:var(--ink-mute); line-height:1.45; }

/* Indice visuel discret invitant au clic (masqué par défaut, révélé au survol) */
.challenge-node-hint{
  display:flex; align-items:center; justify-content:center; gap:4px;
  margin-top:8px;
  font-size:.6rem; font-weight:600;
  color:var(--cyan-600);
  opacity:0;
  transform:translateY(-2px);
  transition:opacity var(--dur-fast) var(--ease), transform var(--dur-fast) var(--ease);
}
.challenge-node-hint svg{ flex:0 0 auto; }
.challenge-node:hover .challenge-node-hint,
.challenge-node:focus-visible .challenge-node-hint{
  opacity:1;
  transform:translateY(0);
}

/* Modal détail défi */
.challenge-modal-overlay, .pt-modal-overlay{
  position:fixed; inset:0; z-index:200;
  background:rgba(8,25,46,.5);
  backdrop-filter:blur(3px);
  display:flex; align-items:center; justify-content:center;
  opacity:0; visibility:hidden;
  transition:opacity var(--dur-med) var(--ease);
  padding:24px;
}
.challenge-modal-overlay.active, .pt-modal-overlay.active{ opacity:1; visibility:visible; }
.challenge-modal, .pt-modal{
  position:relative;
  background:var(--white);
  border-radius:var(--radius-lg);
  box-shadow:var(--shadow-lg);
  max-width:560px; width:100%;
  padding:32px;
  transform:translateY(10px) scale(.98);
  transition:transform var(--dur-med) var(--ease);
}
.challenge-modal-overlay.active .challenge-modal,
.pt-modal-overlay.active .pt-modal{ transform:translateY(0) scale(1); }
.challenge-modal-close, .pt-modal-close, .cnn-panel-close{
  position:absolute; top:18px; right:18px;
  background:var(--gray-100); border:none;
  color:var(--ink-soft);
  font-size:.72rem; font-weight:600;
  padding:7px 14px; border-radius:var(--radius-pill);
  cursor:pointer;
  transition:background var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
}
.challenge-modal-close:hover, .pt-modal-close:hover, .cnn-panel-close:hover{ background:var(--navy-800); color:var(--white); }
.challenge-modal-media{
  border-radius:var(--radius-md);
  overflow:hidden;
  background:var(--gray-50);
  border:1px solid var(--line);
  min-height:220px;
  max-height:52vh;
  display:flex; align-items:center; justify-content:center;
  margin-bottom:18px;
}
.challenge-modal-media img{ width:100%; height:100%; max-height:52vh; object-fit:cover; }
.challenge-modal-fallback{ display:none; color:var(--ink-mute); font-size:var(--fs-small); padding:40px; }
.challenge-modal-media.fallback img{ display:none; }
.challenge-modal-media.fallback .challenge-modal-fallback{ display:block; }
.challenge-modal-body h3{ font-size:var(--fs-h3); margin-bottom:8px; color:var(--navy-800); }
.challenge-modal-body p{ font-size:var(--fs-small); color:var(--ink-soft); line-height:1.65; margin-bottom:10px; }
.challenge-modal-caption{ font-size:var(--fs-micro); color:var(--ink-mute); font-style:italic; }

.pt-modal-eyebrow{ display:block; font-family:var(--f-display); font-weight:600; font-size:.7rem; letter-spacing:.12em; text-transform:uppercase; color:var(--cyan-600); margin-bottom:8px; }
.pt-modal h3{ font-size:var(--fs-h3); margin-bottom:12px; }
.pt-modal-content{ font-size:var(--fs-small); color:var(--ink-soft); line-height:1.65; }

/* ============================================================================
   15. POURQUOI YOLO ? — cartes numérotées
   ========================================================================== */
.yolo-intro-subtitle{
  font-size:var(--fs-body);
  color:var(--ink-soft);
  margin:-8px 0 26px;
}
.yolo-intro-grid{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:var(--space-4);
}
.yolo-intro-card{
  padding:24px 22px;
  position:relative;
}
.yolo-intro-card:hover{ transform:translateY(-4px); box-shadow:var(--shadow-md); border-color:var(--cyan-400); }
.yolo-intro-card-num{
  display:inline-block;
  font-family:var(--f-mono);
  font-size:.72rem; font-weight:700;
  color:var(--cyan-600);
  background:var(--cyan-100);
  padding:3px 9px;
  border-radius:var(--radius-pill);
  margin-bottom:14px;
}
.yolo-intro-card-title{ font-size:calc(var(--fs-body) + 1px); color:var(--navy-800); margin-bottom:8px; }
.yolo-intro-card-text{ font-size:var(--fs-small); color:var(--ink-soft); line-height:1.65; }

/* ============================================================================
   16. PROBLÉMATIQUE
   ========================================================================== */
.problem-intro{
  font-size:var(--fs-h3);
  font-weight:500;
  color:var(--navy-700);
  line-height:1.5;
  margin-bottom:22px;
  max-width:900px;
}
.problem-card{ padding:24px 26px; display:flex; flex-direction:column; gap:14px; margin-bottom:20px; }
.problem-card p{ font-size:var(--fs-small); line-height:1.75; color:var(--ink-soft); }
.research-question{
  padding:22px 26px;
  background:linear-gradient(150deg, var(--navy-800), var(--navy-700));
  display:flex; flex-direction:column; gap:10px;
}
.rq-label{
  font-family:var(--f-display); font-weight:600;
  font-size:.7rem; letter-spacing:.14em; text-transform:uppercase;
  color:var(--cyan-400);
}
.research-question p{ color:var(--white); font-size:var(--fs-body); line-height:1.6; font-weight:500; }

/* ============================================================================
   17. CNN — VUE D'ENSEMBLE (Input → Backbone → Neck → Head → Output)
   ========================================================================== */
.cnn-overview{
  display:flex; align-items:center; justify-content:center;
  gap:0;
  width:100%;
  margin-bottom:var(--space-4);
}
.ov-node{
  flex:0 1 170px;
  padding:14px 18px;
  background:var(--bg-card);
  border:1px solid var(--line);
  border-radius:var(--radius-md);
  text-align:center;
  font-family:var(--f-display);
  font-weight:600;
  font-size:var(--fs-small);
  color:var(--navy-700);
  box-shadow:var(--shadow-xs);
  transition:all var(--dur-fast) var(--ease);
}
.ov-node.ov-explorable, .ov-node.pt-explorable{ cursor:pointer; }
.ov-node.ov-explorable:hover, .ov-node.pt-explorable:hover{
  border-color:var(--cyan-500); color:var(--cyan-600);
  transform:translateY(-3px); box-shadow:var(--shadow-sm);
}
.ov-node.is-active{
  background:var(--navy-800); border-color:var(--navy-800); color:var(--white);
}
.cnn-connector{ flex:1 1 40px; display:flex; align-items:center; min-width:24px; max-width:60px; }
.cnn-connector-h .cline{ width:100%; height:1.5px; background:var(--line); position:relative; }
.cnn-connector-h .cline::after{
  content:'';
  position:absolute; right:0; top:50%; transform:translateY(-50%);
  width:0; height:0;
  border-top:4px solid transparent; border-bottom:4px solid transparent;
  border-left:6px solid var(--gray-400);
}

.cnn-card-grid{
  display:grid;
  grid-template-columns:repeat(4, 1fr);
  gap:var(--space-3);
}
.cnn-card{
  padding:18px 16px;
  text-align:left;
  cursor:pointer;
  position:relative;
  font-family:inherit;
}
.cnn-card:hover, .cnn-card[aria-expanded="true"]{
  transform:translateY(-4px);
  box-shadow:var(--shadow-md);
  border-color:var(--cyan-400);
}
.cnn-card-num{
  display:inline-block;
  font-family:var(--f-mono); font-size:.68rem; font-weight:700;
  color:var(--cyan-600); margin-bottom:8px;
}
.cnn-card h4{ font-size:calc(var(--fs-body) + 1px); color:var(--navy-800); margin-bottom:4px; }
.cnn-card p{ font-size:var(--fs-small); color:var(--ink-soft); margin-bottom:10px; }
.cnn-card-hint{
  font-size:var(--fs-micro); font-weight:600; color:var(--cyan-600);
  display:inline-flex; align-items:center; gap:4px;
}
.cnn-card-hint::after{ content:'→'; transition:transform var(--dur-fast) var(--ease); }
.cnn-card:hover .cnn-card-hint::after{ transform:translateX(3px); }

/* ---- Drawer latéral (panneau de détail) ---- */
.cnn-panel-scrim{
  position:fixed; inset:0; z-index:90;
  background:rgba(8,25,46,.42);
  backdrop-filter:blur(2px);
  opacity:0; visibility:hidden;
  transition:opacity var(--dur-med) var(--ease);
}
.cnn-panel-scrim.active{ opacity:1; visibility:visible; }
.cnn-side-panel{
  position:fixed; top:0; right:0; bottom:0;
  width:min(640px, 92vw);
  background:var(--white);
  z-index:100;
  box-shadow:-24px 0 60px rgba(11,42,74,.2);
  transform:translateX(100%);
  transition:transform var(--dur-slow) var(--ease);
  display:flex; flex-direction:column;
}
.cnn-side-panel.active{ transform:translateX(0); }
.cnn-panel-header{
  display:flex; align-items:flex-start; gap:16px;
  padding:26px 60px 20px 28px;
  border-bottom:1px solid var(--line);
  position:relative;
}
.cnn-panel-step{
  font-family:var(--f-mono); font-weight:700; font-size:.9rem;
  color:var(--cyan-600);
  background:var(--cyan-100);
  border-radius:var(--radius-sm);
  width:34px; height:34px;
  display:flex; align-items:center; justify-content:center;
  flex:0 0 auto;
}
.cnn-panel-eyebrow{
  display:block;
  font-family:var(--f-display); font-weight:600; font-size:.68rem;
  letter-spacing:.12em; text-transform:uppercase;
  color:var(--cyan-600); margin-bottom:4px;
}
.cnn-panel-header h3{ font-size:1.05rem; color:var(--navy-800); }
.cnn-panel-close{ position:absolute; top:22px; right:22px; }
.cnn-panel-body{ flex:1; overflow-y:auto; padding:24px 28px 40px; }
.cnn-panel-content{ display:none; }
.cnn-panel-content.active{ display:block; animation:revealIn var(--dur-med) var(--ease) both; }

.cnn-input-row{ display:flex; align-items:center; gap:16px; }
.cnn-rgb-stack{ position:relative; width:44px; height:44px; flex:0 0 auto; }
.cnn-rgb-stack span{ position:absolute; width:34px; height:34px; border-radius:6px; opacity:.85; }
.cnn-rgb-stack span:nth-child(1){ background:#E0574A; top:0; left:0; }
.cnn-rgb-stack span:nth-child(2){ background:#2FA84F; top:5px; left:5px; }
.cnn-rgb-stack span:nth-child(3){ background:#2E7FB8; top:10px; left:10px; }
.cnn-input-label h4{ font-size:calc(var(--fs-body) + 1px); color:var(--navy-800); margin-bottom:4px; }
.cnn-input-label p{ font-size:var(--fs-small); color:var(--ink-soft); line-height:1.6; }

/* ---- Backbone : suite de conv-blocks ---- */
.backbone-track{
  display:flex; align-items:flex-end; gap:8px;
  padding:20px 10px 8px;
  overflow-x:auto;
}
.conv-block{ display:flex; flex-direction:column; align-items:center; gap:6px; flex:0 0 auto; }
.cb-box{
  width:calc(30px + var(--n, 1) * 4px);
  height:calc(46px + var(--n, 1) * 8px);
  background:linear-gradient(180deg, var(--cyan-400), var(--navy-700));
  border-radius:6px;
  box-shadow:var(--shadow-xs);
}
.cb-label{ font-size:.62rem; color:var(--ink-mute); font-weight:600; white-space:nowrap; }
.cb-tags{ display:flex; gap:4px; flex-wrap:wrap; justify-content:center; }
.cb-tag{
  font-family:var(--f-mono); font-size:.6rem; font-weight:600;
  background:var(--gray-100); color:var(--navy-700);
  border:1px solid var(--line);
  padding:2px 6px; border-radius:5px;
  cursor:pointer;
  transition:all var(--dur-fast) var(--ease);
}
.cb-tag:hover, .cb-tag.is-active{ background:var(--cyan-500); color:var(--white); border-color:var(--cyan-500); }
.cb-arrow{ width:16px; height:1px; background:var(--line); flex:0 0 auto; align-self:center; margin-bottom:22px; }

.layer-detail{ margin-top:14px; min-height:0; }
.layer-detail-empty{ display:block; font-size:var(--fs-small); color:var(--ink-mute); font-style:italic; }
.layer-detail-card{ display:none; padding:16px 18px; background:var(--bg-soft); border:1px solid var(--line); border-radius:var(--radius-md); }
.layer-detail.has-content .layer-detail-empty{ display:none; }
.layer-detail.has-content .layer-detail-card{ display:block; animation:revealIn var(--dur-med) var(--ease) both; }
.ld-label{ display:inline-block; font-family:var(--f-display); font-weight:600; font-size:.78rem; color:var(--navy-800); margin-bottom:8px; }
.ld-formula{ font-family:var(--f-mono); font-size:.86rem; color:var(--cyan-600); background:var(--white); border:1px solid var(--line); padding:8px 12px; border-radius:8px; margin-bottom:8px; }
.ld-role{ font-size:var(--fs-small); color:var(--ink-soft); line-height:1.6; }

.backbone-legend{ display:flex; gap:24px; margin-top:16px; flex-wrap:wrap; }
.bl-item{ display:flex; align-items:center; gap:8px; font-size:var(--fs-micro); color:var(--ink-mute); }
.bl-bar{ width:70px; height:5px; border-radius:99px; background:var(--gray-100); overflow:hidden; }
.bl-bar span{ display:block; height:100%; border-radius:99px; }
.bl-bar.res span{ width:32%; background:linear-gradient(90deg, var(--cyan-500), var(--navy-700)); }
.bl-bar.chan span{ width:82%; background:linear-gradient(90deg, var(--navy-700), var(--cyan-500)); }

.feature-strip{ display:flex; gap:8px; margin-top:16px; flex-wrap:wrap; }
.feat-node{
  padding:6px 12px; border-radius:var(--radius-pill);
  background:var(--gray-50); border:1px solid var(--line);
  font-size:var(--fs-micro); color:var(--ink-soft); font-weight:500;
}

/* ---- Neck ---- */
.neck-panel{ display:flex; flex-direction:column; gap:14px; }
.neck-svg{ width:100%; height:auto; }
.neck-line{ stroke:var(--line); stroke-width:1.4; fill:none; }
.neck-line.up{ stroke:var(--cyan-500); }
.neck-line.down{ stroke:var(--navy-700); }
.neck-box-top{ fill:var(--cyan-100); stroke:var(--cyan-500); stroke-width:1.4; }
.neck-box-bottom{ fill:var(--navy-800); stroke:var(--navy-800); }
.neck-label-dark{ fill:var(--navy-800); font-family:var(--f-display); font-weight:700; font-size:15px; text-anchor:middle; }
.neck-label-light{ fill:var(--white); font-family:var(--f-display); font-weight:700; font-size:15px; text-anchor:middle; }
.neck-sub{ fill:var(--ink-mute); font-family:var(--f-text); font-size:10px; text-anchor:middle; }
.neck-sub-light{ fill:rgba(255,255,255,.7); font-family:var(--f-text); font-size:9px; text-anchor:middle; }
.neck-fusion-circle{ fill:var(--white); stroke:var(--gray-300); stroke-width:1.4; }
.neck-plus{ fill:var(--ink-soft); font-size:15px; font-weight:700; text-anchor:middle; }

.neck-caption-row{ display:flex; gap:18px; flex-wrap:wrap; align-items:center; }
.ncap{ display:inline-flex; align-items:center; gap:7px; font-size:var(--fs-micro); color:var(--ink-soft); font-weight:500; background:none; border:none; cursor:default; padding:0; }
.ncap-btn{ cursor:pointer; }
.ncap i{ width:11px; height:11px; border-radius:3px; display:inline-block; font-style:normal; }
.ncap i.cyan{ background:var(--cyan-500); }
.ncap i.navy{ background:var(--navy-700); }
.ncap i.grad{ background:linear-gradient(90deg, var(--cyan-500), var(--navy-700)); }

/* ---- Fiche explicative générique (concept-detail) ---- */
.concept-detail{ margin-top:16px; }
.concept-detail-empty{ display:flex; align-items:center; gap:8px; font-size:var(--fs-small); color:var(--ink-mute); font-style:italic; }
.concept-detail-card{ display:none; padding:18px 20px; background:var(--bg-soft); border:1px solid var(--line); border-radius:var(--radius-md); }
.concept-detail.has-content .concept-detail-empty{ display:none; }
.concept-detail.has-content .concept-detail-card{ display:block; animation:revealIn var(--dur-med) var(--ease) both; }
.concept-detail-card h4{ font-size:calc(var(--fs-body) + 1px); color:var(--navy-800); margin-bottom:10px; }
.cd-row{ margin-bottom:10px; }
.cd-tag{
  display:inline-block; font-family:var(--f-display); font-weight:600;
  font-size:.65rem; letter-spacing:.08em; text-transform:uppercase;
  color:var(--cyan-600); margin-bottom:4px;
}
.cd-row p{ font-size:var(--fs-small); color:var(--ink-soft); line-height:1.6; }
.cd-formula-box{ margin-top:12px; padding-top:12px; border-top:1px dashed var(--line); }
.cd-formula{ font-family:var(--f-mono); font-size:.85rem; color:var(--navy-700); background:var(--white); border:1px solid var(--line); padding:8px 12px; border-radius:8px; margin:6px 0; }
.cd-formula-note{ font-size:var(--fs-micro); color:var(--ink-mute); }

/* ---- Head : bounding boxes / gauge / classification ---- */
.head-grid{ display:grid; grid-template-columns:repeat(3, 1fr); gap:var(--space-3); }
.head-card{ padding:18px; text-align:left; }
.head-card-clickable{ cursor:pointer; }
.head-card-clickable:hover{ transform:translateY(-3px); box-shadow:var(--shadow-md); border-color:var(--cyan-400); }
.head-card h4{ font-size:calc(var(--fs-body) + 1px); color:var(--navy-800); margin-bottom:6px; }
.head-card p{ font-size:var(--fs-small); color:var(--ink-soft); line-height:1.55; margin-bottom:12px; }
.bbox-mock{ background:var(--bg-soft); border-radius:var(--radius-sm); padding:6px; }
.bbox-mock svg{ width:100%; height:auto; color:var(--navy-700); }
.scheme-text-sm{ font-size:9px; fill:var(--ink-mute); font-family:var(--f-text); }
.bbox-tag{ display:inline-block; margin-top:10px; font-family:var(--f-mono); font-size:.72rem; background:var(--gray-100); color:var(--navy-700); padding:3px 9px; border-radius:6px; }

.gauge-wrap{ display:flex; flex-direction:column; align-items:center; }
.gauge-wrap svg{ width:100%; max-width:150px; }
.gauge-arc-bg{ fill:none; stroke:var(--gray-100); stroke-width:9; stroke-linecap:round; }
.gauge-arc-fg{ fill:none; stroke-width:9; stroke-linecap:round; }
.gauge-value{ font-family:var(--f-display); font-weight:700; font-size:18px; fill:var(--navy-800); text-anchor:middle; }
.gauge-scale{ display:flex; justify-content:space-between; width:100%; max-width:120px; font-size:var(--fs-micro); color:var(--ink-mute); margin-top:-6px; }

.class-chip-list{ display:flex; flex-direction:column; gap:6px; }
.class-chip{ display:grid; grid-template-columns:64px 1fr 34px; align-items:center; gap:8px; font-size:var(--fs-micro); color:var(--ink-soft); }
.cbar-track{ height:5px; border-radius:99px; background:var(--gray-100); overflow:hidden; }
.cbar-fill{ height:100%; border-radius:99px; background:linear-gradient(90deg, var(--cyan-500), var(--navy-700)); }
.cval{ text-align:right; font-family:var(--f-mono); color:var(--navy-700); font-weight:600; }

.detection-row{ display:grid; gap:14px; }
.detection-frame{
  position:relative; width:100%; aspect-ratio:16/9;
  background:var(--bg-soft); border:1px solid var(--line); border-radius:var(--radius-md);
  overflow:hidden;
}
.det-box{ position:absolute; border:2px solid; border-radius:4px; }
.det-tag{ position:absolute; top:-20px; left:-2px; color:var(--white); font-size:.62rem; font-weight:700; padding:2px 6px; border-radius:4px 4px 4px 0; white-space:nowrap; font-family:var(--f-mono); }
.detection-legend{ display:flex; gap:16px; }
.dl-item{ display:flex; align-items:center; gap:6px; font-size:var(--fs-micro); color:var(--ink-soft); }
.dl-swatch{ width:10px; height:10px; border-radius:3px; display:inline-block; }

.nms-note{
  margin-top:16px; padding:14px 18px;
  background:var(--cyan-100); border:1px solid rgba(14,165,196,.25);
  border-radius:var(--radius-md);
}
.nms-note-label{ display:block; font-family:var(--f-display); font-weight:600; font-size:.72rem; letter-spacing:.06em; text-transform:uppercase; color:var(--cyan-600); margin-bottom:6px; }
.nms-note p{ font-size:var(--fs-small); color:var(--navy-700); line-height:1.6; }

/* ============================================================================
   18. POURQUOI UN MODÈLE PRÉ-ENTRAÎNÉ ? — hub / spoke
   ========================================================================== */
.pt-definition{
  font-size:var(--fs-body); color:var(--ink-soft); line-height:1.7;
  max-width:920px; margin-bottom:8px;
}
.pt-term{
  background:none; border:none; padding:0; cursor:pointer;
  color:var(--cyan-600); font-weight:600; text-decoration:underline;
  text-decoration-style:dotted; text-underline-offset:3px;
  font-size:inherit; font-family:inherit;
}
.pt-term:hover{ color:var(--navy-800); }

.pt-utility{ position:relative; width:100%; height:min(46vh, 420px); margin:0 auto; }
.pt-utility-lines{ position:absolute; inset:0; width:100%; height:100%; }
.pt-link{ stroke:var(--line); stroke-width:.5; }

.pt-hub-center{
  position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
  width:130px; height:130px; border-radius:50%;
  background:linear-gradient(155deg, var(--navy-800), var(--navy-700));
  color:var(--white); text-align:center;
  display:flex; align-items:center; justify-content:center;
  font-family:var(--f-display); font-weight:600; font-size:.86rem; line-height:1.3;
  box-shadow:var(--shadow-lg);
  z-index:2;
}
.pt-hub-node{
  position:absolute; transform:translate(-50%,-50%);
  display:flex; flex-direction:column; align-items:center; gap:8px;
  width:150px;
  background:none; border:none; cursor:pointer;
  padding:6px;
  z-index:1;
}
.pt-hub-dot{
  width:14px; height:14px; border-radius:50%;
  background:var(--white); border:3px solid var(--cyan-500);
  transition:all var(--dur-fast) var(--ease);
}
.pt-hub-node:hover .pt-hub-dot{ background:var(--cyan-500); transform:scale(1.15); }
.pt-hub-label{
  font-size:var(--fs-small); font-weight:600; color:var(--navy-700);
  background:var(--bg-card); border:1px solid var(--line);
  padding:8px 12px; border-radius:var(--radius-md);
  box-shadow:var(--shadow-xs);
  line-height:1.35;
  transition:all var(--dur-fast) var(--ease);
}
.pt-hub-node:hover .pt-hub-label{ border-color:var(--cyan-400); box-shadow:var(--shadow-sm); color:var(--navy-800); }
.pt-tooltip{
  position:absolute; width:180px;
  background:var(--navy-800); color:var(--white);
  font-size:var(--fs-micro); line-height:1.5;
  padding:9px 12px; border-radius:8px;
  opacity:0; visibility:hidden; pointer-events:none;
  transition:opacity var(--dur-fast) var(--ease);
  z-index:5;
  box-shadow:var(--shadow-md);
}
.pt-hub-node:hover .pt-tooltip, .pt-hub-node.is-tapped .pt-tooltip{ opacity:1; visibility:visible; }
.pt-tip-below .pt-tooltip{ top:calc(100% + 8px); left:50%; transform:translateX(-50%); }
.pt-tip-above .pt-tooltip{ bottom:calc(100% + 8px); left:50%; transform:translateX(-50%); }

/* ============================================================================
   19. ARCHITECTURE (Backbone/Neck/Head) — panneau détail à fondu
   ========================================================================== */
.bnh-eyebrow{ margin-top:26px; }
.bnh-panel-zone{ position:relative; min-height:64px; margin-top:18px; }
.bnh-panel{
  display:none;
  padding:20px 24px;
  background:var(--bg-soft);
  border:1px solid var(--line);
  border-radius:var(--radius-lg);
}
.bnh-panel.is-visible{ display:block; animation:revealIn var(--dur-med) var(--ease) both; }
.bnh-panel-eyebrow{
  display:inline-block; font-family:var(--f-display); font-weight:600;
  font-size:.72rem; letter-spacing:.1em; text-transform:uppercase;
  color:var(--cyan-600); margin-bottom:10px;
}
.bnh-role-label{ font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--ink-mute); margin:10px 0 6px; }
.bnh-panel p{ font-size:var(--fs-small); color:var(--ink-soft); line-height:1.65; }
.bnh-chip-row{ display:flex; flex-wrap:wrap; gap:8px; }
.bnh-chip{ font-size:var(--fs-micro); font-weight:600; color:var(--navy-700); background:var(--white); border:1px solid var(--line); padding:5px 11px; border-radius:var(--radius-pill); }

/* ============================================================================
   20. TWO-STAGE vs ONE-STAGE — pipeline illustré
   ========================================================================== */
.tsd-wrap{ display:flex; flex-direction:column; gap:14px; }
.tsd-row{ padding:16px 20px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-lg); box-shadow:var(--shadow-xs); }
.tsd-row-tag{
  display:inline-block; font-family:var(--f-display); font-weight:700;
  font-size:.66rem; letter-spacing:.1em;
  padding:4px 11px; border-radius:var(--radius-pill);
  margin-bottom:12px;
}
.tsd-row--two .tsd-row-tag{ background:rgba(29,78,216,.1); color:#1D4ED8; }
.tsd-row--one .tsd-row-tag{ background:rgba(22,163,74,.1); color:#16A34A; }
.tsd-row-body{ display:flex; align-items:stretch; gap:18px; }
.tsd-steps{ display:flex; align-items:flex-start; gap:8px; flex:1; overflow-x:auto; }
.tsd-step-col{ display:flex; flex-direction:column; gap:8px; flex:0 0 auto; width:150px; }
.tsd-step-col--input{ width:110px; }
.tsd-step-col--wide{ width:190px; }
.tsd-step-title{ font-size:.68rem; font-weight:600; color:var(--navy-700); line-height:1.35; min-height:2.6em; }
.tsd-step-title--green{ color:#16A34A; }
.tsd-illus{ position:relative; border-radius:8px; overflow:hidden; border:1px solid var(--line); background:var(--gray-50); }
.tsd-illus--sm{ max-width:96px; }
.tsd-illus-svg{ width:100%; display:block; }
.tsd-overlay{ position:absolute; inset:0; width:100%; height:100%; }
.tsd-tag-text{ font-family:var(--f-mono); font-size:9px; fill:var(--white); }
.tsd-caption{ font-size:.66rem; color:var(--ink-mute); line-height:1.4; }
.tsd-flow-arrow{ flex:0 0 auto; align-self:center; color:var(--gray-400); }

.tsd-crop-list{ display:flex; flex-direction:column; gap:6px; background:var(--gray-50); border-radius:8px; padding:8px; }
.tsd-crop-row{ display:flex; align-items:center; gap:6px; font-size:.64rem; }
.tsd-crop-thumb{ width:26px; height:26px; border-radius:6px; display:flex; align-items:center; justify-content:center; color:var(--white); flex:0 0 auto; }
.tsd-crop-thumb--car{ background:#2563EB; }
.tsd-crop-thumb--bike{ background:#16A34A; }
.tsd-crop-thumb--ped{ background:#DC2626; }
.tsd-crop-label{ flex:1; color:var(--ink-soft); font-weight:500; }
.tsd-crop-check{ color:#16A34A; }

.tsd-onepass{ display:flex; align-items:center; gap:6px; }
.tsd-cnn{ display:flex; align-items:flex-end; gap:3px; height:60px; flex:0 0 auto; }
.tsd-cnn-layer{ width:6px; height:var(--h); background:linear-gradient(180deg, var(--cyan-400), var(--navy-700)); border-radius:2px; }

.tsd-sidecard{ flex:0 0 200px; display:flex; flex-direction:column; gap:10px; justify-content:center; padding:16px 18px; border-radius:var(--radius-md); }
.tsd-sidecard--blue{ background:rgba(29,78,216,.06); border:1px solid rgba(29,78,216,.16); }
.tsd-sidecard--green{ background:rgba(22,163,74,.06); border:1px solid rgba(22,163,74,.16); }
.tsd-fact{ display:flex; align-items:center; gap:9px; font-size:var(--fs-micro); color:var(--ink-soft); font-weight:500; }
.tsd-fact svg{ flex:0 0 auto; color:var(--navy-700); }
.tsd-fact--examples{ padding-top:8px; border-top:1px dashed var(--line); }

.tsd-compare{ padding:16px 20px; background:var(--bg-soft); border:1px solid var(--line); border-radius:var(--radius-lg); }
.tsd-compare-title{ font-family:var(--f-display); font-weight:700; font-size:.7rem; letter-spacing:.12em; color:var(--ink-mute); margin-bottom:12px; }
.tsd-compare-row{ display:grid; grid-template-columns:150px repeat(3, 1fr) 1.4fr; gap:12px; align-items:center; padding:9px 0; border-top:1px solid var(--line); }
.tsd-compare-row:first-of-type{ border-top:none; }
.tsd-compare-tag{ font-size:.66rem; font-weight:700; letter-spacing:.04em; padding:4px 10px; border-radius:var(--radius-pill); text-align:center; }
.tsd-compare-tag--blue{ background:rgba(29,78,216,.1); color:#1D4ED8; }
.tsd-compare-tag--green{ background:rgba(22,163,74,.1); color:#16A34A; }
.tsd-compare-cell{ display:flex; align-items:center; gap:7px; font-size:var(--fs-micro); color:var(--ink-soft); }
.tsd-compare-cell svg{ color:var(--cyan-600); flex:0 0 auto; }
.tsd-compare-cell--concl{ font-weight:600; color:var(--navy-800); }

/* ============================================================================
   21. ANCHOR-BASED vs ANCHOR-FREE — frise chronologique
   ========================================================================== */
.af-title-accent-red{ color:#C0392B; }
.af-title-accent-blue{ color:var(--cyan-600); }
.af-title-vs{ color:var(--ink-mute); font-weight:400; margin:0 10px; }

.af-split{ display:grid; grid-template-columns:1fr 1fr; gap:var(--space-4); margin-bottom:var(--space-4); }
.af-side{ padding:20px 22px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-lg); box-shadow:var(--shadow-xs); border-top:3px solid; }
.af-side.af-red{ border-top-color:#C0392B; }
.af-side.af-blue{ border-top-color:var(--cyan-500); }
.af-side h3{ display:flex; align-items:center; gap:9px; font-size:calc(var(--fs-body) + 1px); margin-bottom:10px; }
.af-side-dot{ width:9px; height:9px; border-radius:50%; }
.af-red .af-side-dot{ background:#C0392B; }
.af-blue .af-side-dot{ background:var(--cyan-500); }
.af-side-def{ font-size:var(--fs-small); color:var(--ink-soft); line-height:1.65; }

.af-timeline-wrap{ display:flex; flex-direction:column; gap:16px; }
.af-timeline{ display:flex; gap:8px; overflow-x:auto; padding-bottom:6px; }
.af-node{ flex:1 1 0; min-width:84px; display:flex; flex-direction:column; align-items:center; gap:6px; text-align:center; padding:12px 6px; border-radius:var(--radius-md); background:var(--bg-card); border:1px solid var(--line); }
.af-node-dot{ width:10px; height:10px; border-radius:50%; background:#C0392B; }
.af-node.af-blue .af-node-dot{ background:var(--cyan-500); }
.af-node.af-exception .af-node-dot{ background:var(--warning); }
.af-node-label{ font-family:var(--f-display); font-weight:700; font-size:.74rem; color:var(--navy-800); }
.af-node-tag{ font-size:.6rem; color:var(--ink-mute); font-weight:600; }
.af-node.af-seg-blue{ background:var(--cyan-100); border-color:rgba(14,165,196,.3); }
.af-node.af-exception{ background:rgba(217,119,6,.08); border-color:rgba(217,119,6,.25); }

.af-legend{ display:flex; gap:20px; flex-wrap:wrap; justify-content:center; }
.af-legend span{ display:flex; align-items:center; gap:7px; font-size:var(--fs-micro); color:var(--ink-soft); }
.af-sw{ width:11px; height:11px; border-radius:3px; display:inline-block; }
.af-sw.af-red{ background:#C0392B; }
.af-sw.af-blue{ background:var(--cyan-500); }
.af-sw.af-exc{ background:var(--warning); }

/* ============================================================================
   22. ANCHOR-BASED vs ANCHOR-FREE — infographie visuelle
   ========================================================================== */
.anc-title{ display:flex; align-items:baseline; justify-content:center; gap:14px; text-align:center; }
.anc-accent--based{ color:#C0392B; }
.anc-accent--free{ color:var(--cyan-600); }
.anc-vs{ color:var(--ink-mute); font-weight:400; font-size:.7em; }

.anc-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  grid-template-areas:
    "head-based head-free"
    "desc-based desc-free"
    "pipe-based pipe-free"
    "vis-based vis-free"
    "pn-based pn-free";
  gap:10px 22px;
}
.anc-head{ padding:9px 4px; border-radius:var(--radius-sm); text-align:center; font-family:var(--f-display); }
.anc-head strong{ display:block; font-size:.86rem; letter-spacing:.04em; }
.anc-head span{ display:block; font-size:var(--fs-micro); font-weight:400; color:var(--ink-mute); font-family:var(--f-text); margin-top:2px; }
.anc-head--based{ grid-area:head-based; background:rgba(192,57,43,.08); color:#C0392B; }
.anc-head--free{ grid-area:head-free; background:var(--cyan-100); color:var(--cyan-600); }
.anc-desc{ font-size:var(--fs-micro); color:var(--ink-soft); line-height:1.55; }
.anc-desc--based{ grid-area:desc-based; }
.anc-desc--free{ grid-area:desc-free; }

.anc-pipeline{ display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
.anc-pipeline--based{ grid-area:pipe-based; }
.anc-pipeline--free{ grid-area:pipe-free; }
.anc-pipe-step{ display:flex; flex-direction:column; align-items:center; gap:5px; text-align:center; }
.anc-pipe-icon{
  width:38px; height:38px; border-radius:9px;
  background:var(--gray-50); border:1px solid var(--line);
  display:flex; align-items:center; justify-content:center;
  color:var(--navy-700);
}
.anc-pipe-icon svg{ width:20px; height:20px; fill:none; stroke:currentColor; stroke-width:1.8; }
.anc-pipe-icon--grid-based, .anc-pipe-icon--grid-free{ display:grid; grid-template-columns:repeat(3,1fr); gap:2px; padding:5px; }
.anc-pipe-icon--grid-based span, .anc-pipe-icon--grid-free span{ background:var(--cyan-500); border-radius:1px; }
.anc-pipe-icon--nms{ font-family:var(--f-mono); font-size:.6rem; font-weight:700; color:var(--white); background:var(--navy-800); }
.anc-pipe-step span{ font-size:.6rem; color:var(--ink-mute); font-weight:500; }
.anc-pipe-arrow{ width:16px; height:14px; color:var(--gray-400); fill:none; stroke:currentColor; stroke-width:2; flex:0 0 auto; }
.anc-pipe-note{
  flex:0 0 100%;
  font-size:var(--fs-micro); color:var(--ink-soft);
  background:var(--gray-50); border-radius:8px; padding:8px 12px;
  margin-top:2px;
}
.anc-pipe-note ul{ margin-top:4px; padding-left:16px; list-style:disc; }

.anc-visual{ display:flex; flex-direction:column; align-items:center; gap:6px; }
.anc-visual--based{ grid-area:vis-based; }
.anc-visual--free{ grid-area:vis-free; }
.anc-visual svg{ max-width:100%; height:auto; }
.anc-legend{ display:flex; flex-wrap:wrap; gap:8px 14px; justify-content:center; }
.anc-legend-item{ display:flex; align-items:center; gap:5px; font-size:.6rem; color:var(--ink-soft); }
.anc-swatch{ width:13px; height:9px; border-radius:2px; display:inline-block; }
.anc-swatch--dot{ width:8px; height:8px; border-radius:50%; }
.anc-visual-caption{ font-size:.6rem; color:var(--ink-mute); text-align:center; }

.anc-posneg{ display:flex; gap:8px; flex-wrap:wrap; justify-content:center; }
.anc-posneg--based{ grid-area:pn-based; }
.anc-posneg--free{ grid-area:pn-free; }
.anc-chip{ display:inline-flex; align-items:center; gap:6px; font-size:.62rem; font-weight:500; padding:5px 10px; border-radius:var(--radius-pill); }
.anc-chip svg{ width:12px; height:12px; fill:none; stroke:currentColor; stroke-width:2.4; }
.anc-chip--pos{ background:rgba(22,163,74,.1); color:#16A34A; }
.anc-chip--neg{ background:rgba(220,38,38,.1); color:#DC2626; }
.anc-chip--ignore{ background:var(--gray-100); color:var(--ink-mute); }
.anc-dash{ width:10px; height:2px; background:var(--ink-mute); display:inline-block; }

.anc-summary{ display:grid; grid-template-columns:1fr auto 1fr; gap:18px; align-items:center; margin-top:16px; }
.anc-summary-col{ display:flex; flex-direction:column; gap:6px; }
.anc-summary-col ul{ display:flex; flex-direction:column; gap:5px; }
.anc-summary-col li{ font-size:var(--fs-micro); padding-left:16px; position:relative; color:var(--ink-soft); line-height:1.5; }
.anc-summary-col li::before{ position:absolute; left:0; font-weight:700; }
.anc-summary-col li.pos::before{ content:'+'; color:#16A34A; }
.anc-summary-col li.neg::before{ content:'–'; color:#DC2626; }
.anc-summary-col--right{ text-align:right; }
.anc-summary-col--right li{ padding-left:0; padding-right:16px; }
.anc-summary-col--right li::before{ left:auto; right:0; }
.anc-summary-vs{ display:flex; flex-direction:column; align-items:center; gap:6px; color:var(--ink-mute); font-weight:700; font-size:.78rem; }
.anc-summary-thumb{ width:26px; height:26px; color:var(--gray-400); }
.anc-summary-thumb svg{ width:100%; height:100%; fill:none; stroke:currentColor; stroke-width:1.8; }

/* ============================================================================
   23. NMS — Non-Maximum Suppression
   ========================================================================== */
.nms-split{ display:grid; grid-template-columns:1fr 1fr; gap:var(--space-4); }
.nms-col{ display:flex; flex-direction:column; gap:16px; }
.nms-def{ padding:16px 20px; background:var(--bg-card); border:1px solid var(--line); border-left:3px solid var(--cyan-500); border-radius:var(--radius-md); }
.nms-def p{ font-size:var(--fs-small); color:var(--ink-soft); line-height:1.65; }

.nms-compare{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
.nms-side{ padding:14px 16px; border-radius:var(--radius-md); border:1px solid var(--line); }
.nms-side h3{ display:flex; align-items:center; gap:8px; font-size:.84rem; margin-bottom:8px; }
.nms-side-dot{ width:8px; height:8px; border-radius:50%; }
.nms-red{ background:rgba(192,57,43,.05); }
.nms-red .nms-side-dot{ background:#C0392B; }
.nms-cyan{ background:var(--cyan-100); }
.nms-cyan .nms-side-dot{ background:var(--cyan-500); }
.nms-side ul{ display:flex; flex-direction:column; gap:5px; }
.nms-side li{ font-size:var(--fs-micro); color:var(--ink-soft); padding-left:14px; position:relative; }
.nms-side li::before{ content:'–'; position:absolute; left:0; color:var(--ink-mute); }

.nms-steps{ padding:16px 18px; background:var(--bg-soft); border:1px solid var(--line); border-radius:var(--radius-md); }
.nms-steps h4{ font-size:var(--fs-small); color:var(--navy-800); margin-bottom:10px; }
.nms-steps ol{ display:flex; flex-direction:column; gap:6px; counter-reset:nms; }
.nms-steps li{ font-size:var(--fs-micro); color:var(--ink-soft); padding-left:22px; position:relative; counter-increment:nms; }
.nms-steps li::before{
  content:counter(nms); position:absolute; left:0; top:0;
  width:15px; height:15px; border-radius:50%;
  background:var(--cyan-500); color:var(--white);
  font-size:.58rem; font-weight:700;
  display:flex; align-items:center; justify-content:center;
}

.nms-visual{ padding:14px 16px; background:var(--bg-card); border:1px solid var(--line); border-radius:var(--radius-lg); box-shadow:var(--shadow-xs); }
.nms-visual-caption{ display:flex; justify-content:space-between; font-size:var(--fs-micro); color:var(--ink-mute); margin-bottom:8px; }
.nms-visual svg{ width:100%; height:auto; border-radius:8px; }
.nms-fade{ animation:revealIn var(--dur-slow) var(--ease) both; }
.nms-legend{ display:flex; flex-wrap:wrap; gap:14px; margin-top:10px; }
.nms-legend span{ display:flex; align-items:center; gap:6px; font-size:.62rem; color:var(--ink-soft); }
.nms-sw{ width:11px; height:11px; border-radius:3px; display:inline-block; }
.nms-sw.nms-red{ background:#C7532F; }
.nms-sw.nms-cyan{ background:var(--cyan-500); }
.nms-sw.nms-navy{ background:var(--navy-700); }

.nms-advlim{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }

/* ============================================================================
   24. YG-ROWS — chaînes d'architecture par version YOLO
   ========================================================================== */
.yg-rows{ display:flex; flex-direction:column; gap:12px; }
.yg-row{
  display:grid;
  grid-template-columns:190px 1fr;
  gap:18px;
  padding:14px 18px;
  background:var(--bg-card);
  border:1px solid var(--line);
  border-radius:var(--radius-md);
  box-shadow:var(--shadow-xs);
  border-left:3px solid var(--cyan-500);
  transition:box-shadow var(--dur-fast) var(--ease);
}
.yg-row:hover{ box-shadow:var(--shadow-sm); }
.yg-c1{ border-left-color:var(--cyan-500); }
.yg-c2{ border-left-color:var(--navy-700); }
.yg-c3{ border-left-color:var(--violet); }
.yg-c4{ border-left-color:#16A34A; }

.yg-label{ display:flex; flex-direction:column; justify-content:center; gap:5px; }
.yg-badge{
  display:inline-block; width:fit-content;
  font-family:var(--f-display); font-weight:700; font-size:.78rem;
  color:var(--navy-800);
  background:var(--gray-50); border:1px solid var(--line);
  padding:4px 10px; border-radius:var(--radius-pill);
}
.yg-tagline{ font-size:.68rem; color:var(--ink-mute); line-height:1.4; }

.yg-body{ min-width:0; }
.yg-chain{ display:flex; align-items:center; gap:4px; flex-wrap:wrap; }
.yg-box{
  display:flex; flex-direction:column; align-items:center; gap:1px;
  background:var(--gray-50); border:1px solid var(--line);
  border-radius:8px; padding:7px 11px;
  cursor:pointer;
  transition:all var(--dur-fast) var(--ease);
  font-family:inherit;
}
.yg-box:hover, .yg-box.is-active{ background:var(--navy-800); border-color:var(--navy-800); transform:translateY(-2px); box-shadow:var(--shadow-sm); }
.yg-box-t{ font-size:.66rem; font-weight:600; color:var(--navy-700); white-space:nowrap; }
.yg-box:hover .yg-box-t, .yg-box.is-active .yg-box-t{ color:var(--white); }
.yg-box-d{ font-size:.58rem; color:var(--ink-mute); font-family:var(--f-mono); }
.yg-box:hover .yg-box-d, .yg-box.is-active .yg-box-d{ color:var(--cyan-300, #7FE0F0); }
.yg-arrow{ color:var(--gray-400); font-size:.8rem; flex:0 0 auto; }
.yg-caption{ font-size:.66rem; color:var(--ink-mute); margin-top:8px; line-height:1.5; }
.yg-caption strong{ color:var(--ink-soft); font-weight:600; }
.yg-struct{ display:block; margin-top:4px; font-style:italic; color:var(--gray-500); }

/* ============================================================================
   25. TABLEAU COMPARATIF (tc-table) & TABLEAU MÉTHODOLOGIE (meth-table)
   ========================================================================== */
.tc-wrap, .meth-table-wrap{
  border:1px solid var(--line);
  border-radius:var(--radius-lg);
  overflow:hidden;
  box-shadow:var(--shadow-sm);
}
.tc-table, .meth-table{
  width:100%;
  border-collapse:collapse;
  background:var(--white);
}
.tc-table th, .meth-table th{
  background:var(--navy-800);
  color:var(--white);
  font-family:var(--f-display);
  font-weight:600;
  font-size:.72rem;
  letter-spacing:.03em;
  text-align:left;
  padding:12px 16px;
}
.tc-table td, .meth-table td{
  padding:11px 16px;
  font-size:var(--fs-micro);
  color:var(--ink-soft);
  border-top:1px solid var(--line-soft);
  vertical-align:top;
  line-height:1.5;
}
.tc-table tbody tr:nth-child(even), .meth-table tbody tr:nth-child(even){ background:var(--bg-soft); }
.tc-table tbody tr:hover, .meth-table tbody tr:hover{ background:var(--cyan-100); }

.tc-version{ display:flex; align-items:center; gap:8px; font-weight:700; color:var(--navy-800); font-size:.8rem; }
.tc-version-dot{ width:7px; height:7px; border-radius:50%; background:var(--cyan-500); flex:0 0 auto; }
.tc-nmsfree .tc-version-dot{ background:#C0392B; }
.tc-badge{ font-family:var(--f-mono); font-size:.58rem; font-weight:700; background:rgba(192,57,43,.1); color:#C0392B; padding:2px 7px; border-radius:var(--radius-pill); }
.tc-innovation{ font-weight:500; color:var(--navy-700); }
.tc-strength{ color:var(--cyan-600); font-weight:600; }
.tc-limit{ color:var(--gray-600); }
.tc-when{ color:var(--ink-mute); font-style:italic; }

.tc-legend{ display:flex; gap:22px; margin-top:14px; flex-wrap:wrap; }
.tc-legend span{ display:flex; align-items:center; gap:7px; font-size:var(--fs-micro); color:var(--ink-soft); }
.tc-sw{ width:11px; height:11px; border-radius:3px; display:inline-block; }
.tc-sw.tc-cyan{ background:var(--cyan-500); }
.tc-sw.tc-red{ background:#C0392B; }

.meth-subtitle{ font-size:var(--fs-body); color:var(--ink-soft); margin:-8px 0 22px; }
.meth-table .metric-name{ font-weight:600; color:var(--navy-800); }
.meth-table .rel-cell{ font-family:var(--f-mono); font-size:.72rem; color:var(--cyan-600); white-space:nowrap; }
.meth-table .dash{ color:var(--ink-mute); font-style:italic; }
col.c-metric{ width:16%; } col.c-def{ width:30%; } col.c-rel{ width:26%; } col.c-obj{ width:28%; }

/* ============================================================================
   26. RÉSULTATS ET DÉMONSTRATION (captures d'écran)
   ========================================================================== */
.res-subtitle{ font-size:var(--fs-body); color:var(--ink-soft); margin:-8px 0 22px; max-width:900px; }
.res-shots{ display:grid; grid-template-columns:repeat(2, 1fr); gap:var(--space-4); }
.res-shots:has(.res-shot-card:only-child){ grid-template-columns:1fr; }
.res-shot-card{ overflow:hidden; }
.res-shot-caption{
  display:flex; align-items:center; gap:8px;
  padding:12px 16px;
  font-family:var(--f-display); font-weight:600; font-size:.76rem;
  color:var(--navy-800);
  border-bottom:1px solid var(--line);
  background:var(--gray-50);
}
.res-shot-caption svg{ width:16px; height:16px; color:var(--cyan-600); flex:0 0 auto; }
.res-shot-card img{ width:100%; display:block; }
.res-shot-card:hover{ transform:translateY(-3px); box-shadow:var(--shadow-md); border-color:var(--cyan-400); }

/* ============================================================================
   27. CONCLUSION & CLOTURE
   ========================================================================== */
.ccl-lead{ font-size:var(--fs-h3); font-weight:500; color:var(--navy-700); line-height:1.55; max-width:960px; margin-bottom:24px; }
.ccl-lead strong{ color:var(--navy-800); }
.ccl-grid{ display:grid; grid-template-columns:1.3fr 1fr; gap:var(--space-4); }
.ccl-card{ padding:24px; }
.ccl-card-label{ font-family:var(--f-display); font-weight:600; font-size:.68rem; letter-spacing:.1em; text-transform:uppercase; color:var(--cyan-600); margin-bottom:8px; }
.ccl-card-title{ font-size:calc(var(--fs-body) + 2px); color:var(--navy-800); margin-bottom:10px; }
.ccl-card-text{ font-size:var(--fs-small); color:var(--ink-soft); line-height:1.65; margin-bottom:16px; }
.ccl-finding{ display:flex; gap:10px; padding-top:14px; border-top:1px dashed var(--line); }
.ccl-finding-icon{ flex:0 0 auto; width:24px; height:24px; border-radius:50%; background:var(--cyan-100); color:var(--cyan-600); display:flex; align-items:center; justify-content:center; }
.ccl-finding-icon svg{ width:13px; height:13px; }
.ccl-finding p{ font-size:var(--fs-small); color:var(--navy-700); font-weight:500; line-height:1.55; }

.ccl-persp-title{ font-family:var(--f-display); font-weight:600; font-size:calc(var(--fs-body) + 1px); color:var(--navy-800); margin-bottom:12px; }
.ccl-persp-list{ display:flex; flex-direction:column; gap:9px; }
.ccl-persp-list li{ font-size:var(--fs-small); color:var(--ink-soft); padding-left:18px; position:relative; line-height:1.5; }
.ccl-persp-list li::before{ content:'→'; position:absolute; left:0; color:var(--cyan-500); font-weight:700; }

.ccl-closing{
  display:flex; align-items:center; justify-content:space-between; gap:24px;
  padding:38px 44px;
  background:linear-gradient(150deg, var(--navy-800), var(--navy-700));
  border-radius:var(--radius-lg);
  box-shadow:var(--shadow-lg);
}
.ccl-closing-text{ font-family:var(--f-display); font-weight:700; font-size:var(--fs-h2); color:var(--white); margin-bottom:6px; }
.ccl-closing-sub{ font-size:var(--fs-body); color:rgba(255,255,255,.78); }
.ccl-qa-pill{
  display:inline-flex; align-items:center; gap:9px;
  padding:11px 20px; border-radius:var(--radius-pill);
  background:rgba(255,255,255,.1); border:1px solid rgba(255,255,255,.2);
  color:var(--white); font-size:var(--fs-small); font-weight:500;
  white-space:nowrap;
}
.ccl-qa-pill svg{ width:17px; height:17px; color:var(--cyan-400); }

/* ============================================================================
   28. RESPONSIVE — 1920×1080 / 1600×900 / 1366×768 / vidéoprojecteur
   Le fit-wrap (script.js) garantit qu'aucun contenu ne déborde jamais ;
   ces règles affinent la densité et les proportions selon la résolution.
   ========================================================================== */

/* Petits vidéoprojecteurs / portables 1366×768 et moins */
@media (max-width: 1440px), (max-height: 800px){
  :root{
    --slide-pad-x: clamp(24px, 4.4vw, 64px);
    --slide-pad-y: clamp(14px, 3vh, 34px);
  }
  .yolo-intro-grid, .head-grid, .cnn-card-grid{ gap:14px; }
  .yg-row{ grid-template-columns:160px 1fr; gap:14px; padding:11px 14px; }
  .challenge-wheel{ width:min(80vw, 620px); }
}

/* Grands écrans 1920×1080 et plus : un peu plus d'air */
@media (min-width: 1800px){
  :root{ --slide-pad-x: clamp(40px, 6vw, 120px); }
  .slide-inner{ max-width:1280px; }
  .slide-inner.wide{ max-width:1480px; }
}

/* Formats plus étroits (4:3, projecteurs anciens) : empiler les colonnes */
@media (max-aspect-ratio: 4/3){
  .grid-2, .anc-grid, .nms-split, .af-split, .ccl-grid,
  .yolo-intro-grid, .head-grid, .cnn-card-grid, .cnn-onestage-row, .res-shots{
    grid-template-columns:1fr !important;
  }
  .anc-grid{
    grid-template-areas:
      "head-based" "desc-based" "pipe-based" "vis-based" "pn-based"
      "head-free" "desc-free" "pipe-free" "vis-free" "pn-free";
  }
  .yg-row{ grid-template-columns:1fr; }
  .tsd-row-body{ flex-direction:column; }
  .tsd-sidecard{ flex:1 1 auto; }
}

/* Mobile / tablette (aperçu, hors contexte vidéoprojecteur) */
@media (max-width: 720px){
  .topbar-brand, .dots{ display:none; }
  .arrow-nav{ width:36px; height:36px; }
  .cover-people{ flex-direction:column; gap:14px; }
  .cover-divider{ width:34px; height:1px; }
}

/* --------------------------------------------------------------------------
   29. FILET DE SÉCURITÉ ANTI-DÉBORDEMENT
   -------------------------------------------------------------------------- */
.slide-inner, .fit-wrap, .cnn-panel-body, .slide-menu-inner{ overflow-wrap:break-word; word-break:break-word; }
img, svg, table{ max-width:100%; }
table{ width:100%; }

/* --------------------------------------------------------------------------
   30. IMPRESSION / EXPORT PDF (dégradation propre)
   -------------------------------------------------------------------------- */
@media print{
  #bg-canvas, .progress-track, .topbar, .dots, .arrow-nav, .controls,
  .slide-menu, .menu-scrim{ display:none !important; }
  html, body{ overflow:visible; height:auto; }
  .deck{ position:static; }
  .slide{
    position:relative; opacity:1; visibility:visible; transform:none;
    page-break-after:always;
    height:100vh;
  }
}

/* ============================================================================
   31. AJUSTEMENTS COMPLÉMENTAIRES
   ========================================================================== */
.backbone-panel{ display:block; width:100%; }
.cnn-overview-h{ flex-wrap:nowrap; }
.bnh-scheme{ margin-top:6px; }
.cnn-panel-head-text{ display:flex; flex-direction:column; gap:2px; min-width:0; }
.meth-table .def-cell, .meth-table .obj-cell{ color:var(--ink-soft); }
.tsd-step{ animation:revealUp var(--dur-slow) var(--ease) both; }
.neck-line.vert{ stroke:var(--gray-300); }
